{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIDP Context Artifact",
  "type": "object",
  "required": ["schema_version", "artifact", "sources", "commands", "citations", "omitted"],
  "properties": {
    "schema_version": { "const": "aidp.context.v1" },
    "artifact": { "const": "context" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "purpose", "spans"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "spans": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    },
    "commands": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "citations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "omitted": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": false
}
