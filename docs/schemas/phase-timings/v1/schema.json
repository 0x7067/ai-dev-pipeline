{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-dev-pipeline/schemas/phase-timings/v1/schema.json",
  "title": "phase_timings.json (v1)",
  "description": "Per-run phase timing record. Stamped incrementally by the orchestrator (one append per phase, atomic tempfile + rename). Read-only via scripts/parse-phase-timings.sh — direct jq/cat reads are forbidden by .claude/rules/boundary-parse-dont-validate.md.",
  "type": "object",
  "required": ["schema_version", "phases", "total_seconds"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status", "seconds", "started_at"],
        "additionalProperties": false,
        "properties": {
          "name":       { "type": "string", "minLength": 1 },
          "status":     { "type": "string", "enum": ["ok", "fail"] },
          "seconds":    { "type": "integer", "minimum": 0 },
          "started_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
        }
      }
    },
    "total_seconds": { "type": "integer", "minimum": 0 }
  }
}
