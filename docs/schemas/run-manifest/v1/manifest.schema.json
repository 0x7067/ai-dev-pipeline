{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/run-manifest/v1/manifest.schema.json",
  "title": "RunManifest",
  "description": "Per-run manifest emitted at end of /ship. Layer: written by shell, read via boundary parser scripts/parse-manifest.sh. v1.a — additive, no consumer rewires.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "command",
    "status",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "run-manifest/v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z?-[a-f0-9]{6}(-[a-f0-9]{2})?$"
    },
    "started_at": { "type": "string" },
    "ended_at": { "type": "string" },
    "command": { "type": "string" },
    "mode": { "type": "string" },
    "risk_tier": {
      "type": "string",
      "enum": ["low", "medium", "high", "unknown", ""]
    },
    "status": { "type": "string" },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "head":   { "type": "string" },
        "branch": { "type": "string" },
        "dirty":  { "type": "boolean" }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256", "bytes"],
        "properties": {
          "kind":   { "type": "string" },
          "path":   {
            "type": "string",
            "description": "RUN_DIR-relative POSIX path. MUST NOT contain '..', NUL, or be absolute. Realpath MUST stay under RUN_DIR."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes":  {
            "type": "integer",
            "minimum": 0
          },
          "schema": { "type": "string" }
        }
      }
    }
  }
}
