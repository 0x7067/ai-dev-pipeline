# Sample CI gate — copy to .github/workflows/verify.yml in consuming repo.
# Authoritative gate per .claude/rules/release-and-verification.md (Gate Authority).
# The v6 GitHub-owned actions run on Node.js 24 and require Actions Runner
# 2.327.1+ on self-hosted runners.
name: verify

on:
  pull_request:
    branches: [main]

jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v6

      - name: Detect Node.js (optional)
        if: hashFiles('package.json') != ''
        uses: actions/setup-node@v6
        with:
          node-version: lts/*
          # Keep the portable template cache-neutral. Enable lockfile-specific
          # npm/yarn/pnpm caching in consuming repos once the package manager is known.
          package-manager-cache: false

      - name: Detect Python (optional)
        if: hashFiles('pyproject.toml') != '' || hashFiles('setup.py') != ''
        uses: actions/setup-python@v6
        with:
          python-version: '3.x'

      - name: Detect Go (optional)
        if: hashFiles('go.mod') != ''
        uses: actions/setup-go@v6
        with:
          go-version: stable

      - name: Detect Rust (optional)
        if: hashFiles('Cargo.toml') != ''
        uses: dtolnay/rust-toolchain@stable

      - name: Run verification gates
        env:
          MAX_VERIFY_RETRIES: '0'
        run: bash scripts/run-verification-gates.sh

      - name: Upload verify report
        if: always()
        uses: actions/upload-artifact@v6
        with:
          name: verify-report
          path: |
            docs/verify-report.md
            docs/.verify-retry.json
          if-no-files-found: ignore
